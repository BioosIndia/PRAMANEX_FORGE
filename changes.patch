@@ -0,0 +1,6 @@
+import {draftOutcome} from '../lib/draft-outcome.mjs';
+export default function DraftOutcome({state,draft}:{state:any;draft:any}){
+ const r=draftOutcome(state,draft);
+ function download(){const content=['FORGE — review brief',`Draft: ${draft.id} · revision ${r.revision} · Module ${r.section}`,`State: ${r.status}`,'This brief is not a controlled final export or regulatory release.','', 'CURRENT FINDINGS',...r.findings.map((f:any)=>`${f.text}\nEvidence field: ${f.fieldId}`),'','OPEN GAPS',...r.problems,'','NEXT ACTION',r.nextAction].join('\n');const url=URL.createObjectURL(new Blob([content],{type:'text/plain;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download=`forge-${draft.id}-r${r.revision}-review.txt`;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);}
+ return <section aria-label="Current draft outcome" className="editor-note"><h4>What this draft can support</h4><p><strong>{r.status}</strong> · checked against the current workspace evidence</p><p>{r.findings.length?`${r.findings.length} statement(s) passed the bounded evidence and wording checks. Read the candidates and inspect their sources below.`:'No complete supported draft can progress yet. The candidate wording below remains available for inspection.'}</p>{r.problems.length>0&&<ul>{r.problems.map((p:string)=><li key={p}>{p}</li>)}</ul>}<p><strong>Next action: </strong>{r.nextAction}</p><p>Scientific suitability and regulatory judgement require a qualified human reviewer. Automatic release: false.</p><button className="btn secondary" onClick={download}>Download review brief</button></section>;
+}
