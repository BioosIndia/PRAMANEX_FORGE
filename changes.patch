@@ -0,0 +1,12 @@
+import {buildWorkingProof} from './working-proof.mjs';
+import {initialState,parseSource,normalizeField,command,actorCan} from './core.mjs';
+import {mergeSpecialistOutputs} from './agentic.mjs';
+import {statementIssues} from './statement-controls.mjs';
+import type {QualityAdapter,Check} from './quality-monitor';
+const source={id:'SYNTHETIC-CMC-CANARY',version:1,text:'Independent synthetic CMC exercise. Batch SYN-A. Method HPLC-SYN-01. COA assay: 98.6%. A batch record reports assay 99.1% for the same batch and method. No accepted assay has been established. Dissolution evidence is missing. No approved CMC output or automatic release is permitted.'};
+export const qualityAdapter:QualityAdapter={product:'FORGE',version:'forge-quality/2026-10-12.1',fixture:()=>source,provider:()=> 'groq',preferred:env=>[env.FORGE_MODEL||env.GROQ_MODEL||'openai/gpt-oss-20b',env.FORGE_REVIEWER_MODEL||env.GROQ_REVIEWER_MODEL||'openai/gpt-oss-120b'],canary:()=>({source,expected:{sourceId:source.id,sourceVersion:1,originalAssay:'98.6%',transcribedAssay:'99.1%',batch:'SYN-A',method:'HPLC-SYN-01',dissolution:null,status:'HOLD',release:false},instruction:'Copy both distinct assay values exactly with percent signs. Keep the original batch and method. Missing dissolution is null. Conflict stays HOLD and release false. Do not choose an accepted assay or claim method validation.'}),checks:async()=>{
+ const proof=await buildWorkingProof(),fresh=initialState('Quality canary only');const fact={parameter:'assay',value:98.6,unit:'%',batch:'SYN-A',method:'HPLC-SYN-01'};let stale=false,anonymous=false;try{await command(fresh,{action:'draft',expectedVersion:99},{id:'synthetic',role:'author'});}catch{stale=true;}try{await command(fresh,{action:'draft',expectedVersion:0},{id:'synthetic',role:'viewer'});}catch{anonymous=true;}
+ const parsed=parseSource('{"parameters":[{"parameter":"assay","value":98.600,"unit":"%","batch":"SYN-A","method":"HPLC-SYN-01"}]}','application/json')[0];const converted=normalizeField({...parsed,rawValue:'986',rawUnit:'mg/g',basis:'mass'});
+ const cases:[string,boolean,unknown,unknown][]=[['FRESH_WORKSPACE_EMPTY',fresh.sources.length===0&&fresh.fields.length===0,0,fresh.sources.length],['ASSAY_CONFLICT_RETAINED',proof.state.conflicts.some((c:any)=>c.status==='OPEN'),true,proof.state.conflicts.some((c:any)=>c.status==='OPEN')],['MISSING_DISSOLUTION_VISIBLE',proof.summary.missing.includes('dissolution'),true,proof.summary.missing.includes('dissolution')],['CONTROLLED_EXPORT_BLOCKED',proof.summary.exportReady===false,false,proof.summary.exportReady],['RELEASE_LOCKED',proof.release===false,false,proof.release],['ORIGINAL_PRECISION_PRESERVED',parsed.rawValue==='98.600','98.600',parsed.rawValue],['EXPLICIT_UNIT_CONVERSION',converted.value===98.6&&converted.unit==='%',{value:98.6,unit:'%'},{value:converted.value,unit:converted.unit}],['STALE_WRITE_REJECTED',stale,true,stale],['VIEWER_WRITE_REJECTED',anonymous&&!actorCan('viewer','draft'),true,anonymous],['UNSUPPORTED_UNIT_REJECTED',statementIssues('assay: 98.6 mg for SYN-A using HPLC-SYN-01.',fact).length>0,true,statementIssues('assay: 98.6 mg for SYN-A using HPLC-SYN-01.',fact).length>0],['CONFLICTING_AGENT_REVISIONS_HELD',mergeSpecialistOutputs([{role:'A3',inputRevision:1},{role:'A5',inputRevision:2}]).status==='HOLD','HOLD',mergeSpecialistOutputs([{role:'A3',inputRevision:1},{role:'A5',inputRevision:2}]).status]];
+ return cases.map(([id,pass,expected,actual])=>({id,pass,expected,actual})) as Check[];
+}};
