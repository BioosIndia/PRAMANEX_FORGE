+'use client';
+import {useEffect,useState} from 'react';
+export default function QualityMonitorPanel({product,compact=false}:{product:string;compact?:boolean}){
+ const [data,setData]=useState<any>(null),[error,setError]=useState(''),[busy,setBusy]=useState(false);
+ async function refresh(){setBusy(true);setError('');try{const r=await fetch('/api/quality/status',{cache:'no-store'});const d:any=await r.json();if(!r.ok||!d.engineering)throw Error('Current saved check unavailable.');setData(d);}catch{setData(null);setError('The current check could not be read. Health remains unknown; retry or contact the owner.');}finally{setBusy(false);}}
+ useEffect(()=>{void refresh();},[]);
+ const label=(v:any)=>typeof v==='string'?v.replaceAll('_',' '):'Not recorded';
+ const short=(v:unknown)=>typeof v==='string'?v:JSON.stringify(v);
+ return <section aria-label={product+' saved quality checks'} style={{background:'#f4f8fb',color:'#162c42',border:'1px solid #cbd9e3',borderRadius:14,padding:compact?18:24,margin:'18px 0',fontSize:14,lineHeight:1.55}}>
+  <div style={{display:'flex',alignItems:'center',justifyContent:'space-between',gap:16,flexWrap:'wrap'}}><div><small style={{letterSpacing:1.1,color:'#456275'}}>SAVED ENGINEERING CHECKS · {product}</small><h2 style={{fontSize:compact?19:25,margin:'5px 0'}}>Quality checks that keep their evidence</h2><p style={{maxWidth:760}}>Scheduled checks use isolated synthetic inputs. They inspect originals, gaps, current-version rules and the human boundary; they do not sign a professional decision.</p></div><button type="button" onClick={()=>void refresh()} disabled={busy} style={{background:'#155b6b',color:'white',border:0,borderRadius:8,padding:'10px 16px',cursor:busy?'wait':'pointer'}}>{busy?'Reading…':'Refresh saved checks'}</button></div>
+  {error&&<p role="alert" style={{background:'#fff0d6',padding:12,borderRadius:8}}>{error}</p>}
+  {!data&&!error&&<p role="status">Reading saved check status…</p>}
+  {data&&<><div style={{display:'grid',gridTemplateColumns:'repeat(auto-fit,minmax(235px,1fr))',gap:14}}>{[['Control checks',data.engineering],['Live AI canary',data.liveAI]].map(([title,r]:any)=><article key={title} style={{background:'white',border:'1px solid #d3dfe7',padding:16,borderRadius:10}}><strong>{title}</strong><p style={{fontWeight:700,color:/HOLD|FAIL|OVERDUE|STALE|AWAITING/.test((r.state||'')+' '+(r.freshness||''))?'#80500a':'#155b6b'}}>{label(r.state)} · {label(r.freshness)}</p><small>{r.finishedAt?'Saved '+new Date(r.finishedAt).toLocaleString():'No finished receipt yet'}</small><p>{r.checks?`${r.checks.filter((c:any)=>c.pass).length}/${r.checks.length} scoped checks passed`:'No executed checks recorded'}</p>{r.model&&<p>{label(r.model.status)}{r.model.reason?' · '+label(r.model.reason):''}<br/><small>{r.model.models?.join(' / ')||'No model responses established'}</small></p>}</article>)}</div>
+  {!compact&&<><h3 style={{marginTop:24}}>Latest control evidence</h3><div style={{overflowX:'auto'}}><table style={{width:'100%',borderCollapse:'collapse',fontSize:13}}><thead><tr>{['Check','Expected','Observed','Result'].map(x=><th key={x} style={{textAlign:'left',padding:10,borderBottom:'1px solid #b7cbd7'}}>{x}</th>)}</tr></thead><tbody>{(data.engineering.checks||[]).map((c:any)=><tr key={c.id}><td style={{padding:10,borderBottom:'1px solid #d3dfe7'}}>{label(c.id)}</td><td style={{padding:10,overflowWrap:'anywhere',maxWidth:220}}>{short(c.expected)}</td><td style={{padding:10,overflowWrap:'anywhere',maxWidth:220}}>{short(c.actual)}</td><td style={{padding:10,fontWeight:700,color:c.pass?'#155b6b':'#80500a'}}>{c.pass?'PASS':'HOLD'}</td></tr>)}</tbody></table></div><details style={{marginTop:16}}><summary>Run history and first failures</summary>{data.history.map((r:any)=><p key={r.id}><b>{label(r.mode)}</b> · {label(r.state)} · {new Date(r.finishedAt||r.startedAt).toLocaleString()} · {r.integrityVerified?'Receipt verified':'Receipt needs attention'}{r.checks?.find((c:any)=>!c.pass)?' · First failed check: '+label(r.checks.find((c:any)=>!c.pass).id):''}</p>)}</details></>}
+  <div style={{background:'#fff3db',border:'1px solid #e0c898',padding:16,borderRadius:10,marginTop:20}}><strong>Passing controls are not regulated production qualification.</strong><p style={{marginBottom:0}}>Professional accuracy and real-user benefits: NOT ESTABLISHED. Permitted representative data, approved expected answers, qualified independent review, operating procedures and production recovery/load evidence remain required. No automatic approval or release.</p></div></>}
+  <div style={{display:'flex',gap:18,flexWrap:'wrap',marginTop:18}}>{compact&&<a href="/quality" style={{color:'#155b6b',fontWeight:700}}>Open full quality evidence →</a>}<a href="/api/quality/status" style={{color:'#155b6b'}}>Inspect saved receipts</a><a href="/api/quality/protocol" style={{color:'#155b6b'}}>Qualification protocol template</a></div>
+ </section>;
+}
