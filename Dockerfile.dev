# Optional LOCAL-ONLY scaffold; no Docker image was built/verified in this handoff.
FROM node:24-bookworm-slim
WORKDIR /app
ENV CLOUDFLARE_CF_FETCH_ENABLED=false WRANGLER_SEND_METRICS=false
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
RUN corepack pnpm install --frozen-lockfile
COPY . .
RUN mkdir -p .sites-runtime && printf '{"executionProfile":"managed-linux"}' > .sites-runtime/execution-profile.json
EXPOSE 5173
CMD ["node", "scripts/run-framework.mjs", "dev", "--host", "0.0.0.0", "--port", "5173"]
